# 换行策略（跨平台一致：仓库内统一 LF，检出时按类型适配）
* text=auto eol=lf

# PowerShell 脚本：Windows 原生工具链惯用 CRLF（pwsh 两者皆可，取惯例）
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# POSIX shell / 配置 / 文档：恒 LF（避免 CRLF 破坏 shebang 与解释器）
*.sh   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.md   text eol=lf

# 二进制：不做行尾转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.pdf  binary
*.zip  binary
*.gz   binary
